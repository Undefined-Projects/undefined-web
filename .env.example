# ── CMS (Keystatic) ─────────────────────────────────────────────
# En local no necesitas nada: el panel guarda los cambios en /content.
# En producción (Vercel) cambia a "github" y llena los datos del repo.
NEXT_PUBLIC_KEYSTATIC_STORAGE=local
NEXT_PUBLIC_KEYSTATIC_GITHUB_REPO=tu-usuario/undefined-web
# Estas tres las genera Keystatic la primera vez que entras a /keystatic en producción:
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=

# ── Formularios (contacto y boletín) ────────────────────────────
# Opcional. Sin esto, los formularios responden OK pero solo registran el mensaje en el servidor.
RESEND_API_KEY=
CONTACT_TO=correo@undfinedclub.org
CONTACT_FROM=Undefined <web@undfinedclub.org>
